# ════════════════════════════════════════════════════════════════════════════════
# SMART RAG — Environment Configuration
# ════════════════════════════════════════════════════════════════════════════════
#
# HOW TO USE:
#   cp .env.example .env
#   → Fill in your values, OR run scripts/bootstrap.sh (recommended)
#
# ⚠️  CRITICAL — READ BEFORE CONFIGURING ⚠️
#
#   EMBEDDING MODEL: Once you have ingested documents, changing the embedding
#   model requires re-ingesting ALL content from scratch. The vector dimensions
#   must match exactly between ingestion and retrieval. Choose your model before
#   the first ingestion run and do not change it afterwards.
#
# ════════════════════════════════════════════════════════════════════════════════


# ── DEPLOYMENT MODE ──────────────────────────────────────────────────────────
# "domain"    — your own domain, one subdomain per service, nginx in front,
#               Let's Encrypt certificates. Needs DNS you control and inbound
#               ports 80/443. The only mode in which LTI works.
#
# "tailscale" — no domain of your own. Tailscale terminates TLS with its own
#               certificate and reaches the containers directly; each service
#               gets its own port on this machine's MagicDNS name. Flowise is
#               additionally exposed publicly via Funnel, so students need no
#               Tailscale of their own. nginx and certbot are not used at all.
#               LTI does NOT work in this mode.
#
# Set by the wizard. Changing it by hand does not reconfigure anything.
DEPLOYMENT_MODE="domain"

# Filled in by scripts/install-tailscale.sh once Tailscale is up — the
# MagicDNS name of this machine. Empty in domain mode.
TAILSCALE_HOSTNAME=""

# ── COURSE & DEPLOYMENT ──────────────────────────────────────────────────────
# Decide these values before running bootstrap.sh — they affect collection names,
# bucket names, and agent labels throughout the system.
#
# COURSE_ID: lowercase, no spaces or special characters (a-z, 0-9, hyphens only).
# Used to derive WEAVIATE_COLLECTION_NAME and MinIO bucket names.
#
# It is also written onto every object the agents retrieve — document chunks,
# chat history, user memory, test results — and every agent's retrieval
# filters on it. That is what allows one installation to host more than one
# course: the Weaviate collection is shared, and course_id keeps the courses
# apart. Changing this value after documents have been ingested makes the
# existing ones invisible to the agents until they are re-tagged
# (scripts/migrate-add-course-id.sh --course-id <old-value> can put them back).

COURSE_NAME="My Course Title"
COURSE_ID="my-course"

# DOMAIN: the BASE domain of your deployment (without any prefix).
# All subdomains are derived from this — e.g. smart-rag.${DOMAIN}, n8n.${DOMAIN},
# langfuse.${DOMAIN}, minio.${DOMAIN}, s3.${DOMAIN}, lti.${DOMAIN}.
DOMAIN="example.com"

# SUBDOMAIN_PREFIX: set by the bootstrap wizard automatically — only non-empty
# if one of our default subdomains (n8n, minio, ...) already existed in nginx
# on this host (e.g. a standalone n8n installed separately). When set, every
# subdomain becomes "${SUBDOMAIN_PREFIX}-<service>.${DOMAIN}" instead, e.g.
# "smartrag-n8n.${DOMAIN}". Leave empty for the plain names. Changing this by
# hand after deployment also requires re-running get-ssl-certs.sh (the
# certificate's SAN list must match) and reloading nginx.
SUBDOMAIN_PREFIX=""
# BASE_DATA_PATH: where Docker volume data is persisted (postgres, weaviate,
# minio, etc.). Recommendation: put the repo at /srv/smart-rag/ and the data
# at /srv/smart-rag/data — everything in one place for easy backup.
BASE_DATA_PATH="/srv/smart-rag/data"

# Admin account — used to initialise Flowise, n8n and Langfuse on first run
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="generate-with-bootstrap"

# Timezone — important for n8n cron jobs (memory sync, chat history pipelines)
# Use standard tz database names: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ="Europe/Berlin"


# ── COMPOSE PROFILES ─────────────────────────────────────────────────────────
# Comma-separated list of components to enable.
# Set by scripts/bootstrap.sh — edit manually to add/remove components.
#
#   core          → Flowise, Weaviate, Neo4j, PostgreSQL, Redis, MinIO, n8n
#                   (always required, cannot be disabled)
#   observability → Langfuse + ClickHouse (recommended for production)
#   lti           → LTI 1.3 middleware for Moodle / ILIAS integration

COMPOSE_PROFILES="core,observability"


# ── LLM CONFIGURATION ────────────────────────────────────────────────────────
# The main language model used by your AI agents.
# Credentials are configured in the Flowise UI after deployment.
# scripts/bootstrap.sh uses these values to pre-seed Flowise credentials.
#
# Supported providers:
#   anthropic | openai | google | mistral | cohere | openrouter | custom
#
# For custom/local deployments: set LLM_PROVIDER=custom and provide LLM_BASE_URL.
# The endpoint must be OpenAI-compatible (e.g. LM Studio, vLLM, Ollama).

LLM_PROVIDER="anthropic"

# Strong model — complex reasoning, main agent responses
# Examples: claude-sonnet-4-5 | gpt-4o | gemini-2.5-pro | mistral-large-latest
# Note: claude-sonnet-4-6 has known tool-calling issues — stick to 4-5 until 4-7 is tested.
LLM_MODEL_STRONG="claude-sonnet-4-5"

# Fast model — quick tasks: memory summaries, classification, routing
# Examples: claude-haiku-4-5 | gpt-4o-mini | gemini-2.0-flash-lite | mistral-small-latest
LLM_MODEL_FAST="claude-haiku-4-5"

# API Key (leave empty if your custom endpoint requires no authentication)
LLM_API_KEY="your-llm-api-key-here"

# Base URL — only required if LLM_PROVIDER=custom
# Example: http://my-llm-server:11434/v1
LLM_BASE_URL=""


# ── EMBEDDING CONFIGURATION ──────────────────────────────────────────────────
# ⚠️  Do NOT change after initial data ingestion — see warning at top of file.
#
# Supported providers:
#   openai | cohere | google | mistral | custom
#
# For custom/local deployments: set EMBEDDING_PROVIDER=custom and provide
# EMBEDDING_BASE_URL pointing to an OpenAI-compatible embeddings endpoint.

EMBEDDING_PROVIDER="openai"

# Model name exactly as expected by the provider API
# Examples: text-embedding-3-small | embed-multilingual-v3.0 | text-embedding-004
EMBEDDING_MODEL="text-embedding-3-small"

# ⚠️  Vector dimensions — must exactly match the model output size.
#     bootstrap.sh auto-fills this for known models. For custom models,
#     check your model's documentation.
#
# Known values:
#   openai   text-embedding-3-small      → 1536
#   openai   text-embedding-3-large      → 3072
#   cohere   embed-multilingual-v3.0     → 1024
#   google   text-embedding-004          → 768
#   mistral  mistral-embed               → 1024
EMBEDDING_DIMENSIONS=1536

# API Key for embedding provider (may be the same as LLM_API_KEY)
EMBEDDING_API_KEY="your-embedding-api-key-here"

# Base URL — only required if EMBEDDING_PROVIDER=custom
EMBEDDING_BASE_URL=""


# ── RERANKER CONFIGURATION ───────────────────────────────────────────────────
# Improves retrieval quality by re-scoring retrieved chunks after vector search.
# Used by Weaviate's reranker module.
#
# Supported providers:
#   cohere | custom | none
#
# Set to "none" to disable reranking (pure vector similarity only).
# For custom: provide a URL compatible with the Weaviate reranker-transformers API.

RERANKER_PROVIDER="cohere"

# Cohere reranker model — for multilingual content (German/English) use:
#   rerank-multilingual-v3.0  (recommended for non-English or mixed content)
#   rerank-v3.5               (English-optimised, stronger overall)
RERANKER_MODEL="rerank-multilingual-v3.0"

# API Key (Cohere API key, or leave empty for custom/none)
RERANKER_API_KEY="your-reranker-api-key-here"

# Base URL — only required if RERANKER_PROVIDER=custom
# Example: http://my-reranker-server:8080
RERANKER_BASE_URL=""


# ── MAIL RELAY (SMTP) ────────────────────────────────────────────────────────
# Strongly recommended. Without this, Flowise, n8n, and Langfuse cannot send
# password-reset or invite emails — users locked out of their account have no
# self-service way back in. See docs/requirements.md.
#
# The bootstrap wizard offers two ways to fill these in:
#   a) Install a local Postfix relay (scripts/install-postfix.sh) that forwards
#      through your real mail provider's credentials — apps then talk to
#      Postfix unauthenticated at 172.28.92.1 (the pinned Docker gateway, see
#      `networks:` in docker-compose.yml), so no app needs its own SMTP
#      password. Recommended if you don't already run a relay.
#   b) Point directly at any existing external SMTP relay (host/port/user/pw).
#
# Leave SMTP_HOST empty to disable email sending entirely (safe default —
# services just won't offer password-reset links).

# Set to "true" if scripts/bootstrap.sh --continue should install and
# configure Postfix (see option a above). Requires SMTP_RELAY_* below.
INSTALL_POSTFIX_RELAY="false"
SMTP_RELAY_HOST=""
SMTP_RELAY_PORT=587
SMTP_RELAY_USER=""
SMTP_RELAY_PASSWORD=""

# What Flowise/n8n/Langfuse actually connect to. If INSTALL_POSTFIX_RELAY is
# true, the wizard points these at the local Postfix relay automatically —
# don't edit them by hand in that case.
N8N_EMAIL_MODE=""
SMTP_HOST=""
SMTP_PORT=25
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
SMTP_SENDER_EMAIL="noreply@${DOMAIN}"


# ── WEAVIATE ─────────────────────────────────────────────────────────────────
# WEAVIATE_COLLECTION_NAME: PascalCase, no hyphens.
# bootstrap.sh derives this from COURSE_ID (e.g. "my-course" → "MyCourseChunks").
# The name is historical rather than meaningful: the collection holds every
# course on this installation, kept apart by each object's course_id.
# All components (Flowise agents, n8n workflows, ingest pipeline) must use the
# same name. Change only before first ingestion.

WEAVIATE_COLLECTION_NAME="MyCourseChunks"


# ── HOST PORT BINDINGS ───────────────────────────────────────────────────────
# These are the HOST-side ports each service binds to on 127.0.0.1.
# Change them if you have port conflicts with existing services on this host
# (the bootstrap pre-flight will tell you which ones are taken).
#
# Internal container ports are NOT configurable — services talk to each other
# via Docker DNS (smartrag-flowise:3000, smartrag-weaviate:8080, etc.) and
# those names/ports are baked into the agent JSONs and n8n workflows.

FLOWISE_PORT=3000
N8N_PORT=5678
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
LANGFUSE_PORT=3001
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
LTI_PORT=10088
CONTENT_ADMIN_PORT=3002


# ── n8n WEBHOOK ──────────────────────────────────────────────────────────────
# Public URL that n8n is reachable at — used by MinIO to trigger the ingest
# pipeline when a new document is uploaded. Must be accessible from the server.
# bootstrap.sh sets this automatically from DOMAIN + SUBDOMAIN_PREFIX.

N8N_WEBHOOK_URL="https://n8n.${DOMAIN}"

# Bare hostname (no scheme) for n8n's own N8N_HOST setting — must match the
# host portion of N8N_WEBHOOK_URL above. Set automatically by bootstrap.sh.
N8N_HOSTNAME="n8n.${DOMAIN}"

# Public URLs for the services that need to know their own address.
#
# Fully resolved by bootstrap.sh, INCLUDING SUBDOMAIN_PREFIX — do not write
# them as "https://s3.${DOMAIN}". docker-compose.yml used to build exactly
# that inline, which silently dropped the prefix and pointed MinIO's console
# at a hostname with no DNS record, no vhost and no certificate. These must
# match the server_name entries nginx actually serves.
MINIO_SERVER_URL="https://s3.${DOMAIN}"
MINIO_BROWSER_REDIRECT_URL="https://minio.${DOMAIN}"
# Where Flowise is reachable from a browser. Used by Flowise itself (APP_URL)
# and by the LTI middleware. NOT the bare domain — Flowise lives on the
# smart-rag subdomain.
FLOWISE_PUBLIC_URL="https://smart-rag.${DOMAIN}"
# Where the Content Admin GUI is reachable. Only needed in tailscale mode,
# where it is not on a subdomain of its own; written by install-tailscale.sh.
CONTENT_ADMIN_PUBLIC_URL=""

# Internal MinIO → n8n notification endpoint (do not change path).
#
# The port is HARDCODED to 5678 on purpose. This is a container-to-container
# URL, and n8n always listens on 5678 inside its container (docker-compose.yml
# pins N8N_PORT: "5678" there for exactly this reason). N8N_PORT in this file
# is the HOST-side binding, which the wizard may move to a free port on a
# conflict — using it here made MinIO dial a port nothing listens on inside
# the network, logging "connect: connection refused" on every event.


# ════════════════════════════════════════════════════════════════════════════════
# SECRETS — AUTO-GENERATED BY scripts/bootstrap.sh
# ════════════════════════════════════════════════════════════════════════════════
# ⚠️  Never use the placeholder values below in production.
# ⚠️  Run scripts/bootstrap.sh to generate cryptographically secure secrets.
# ⚠️  After generation, your credentials are saved to credentials.txt — keep it safe.


# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER="smartrag"
POSTGRES_PASSWORD="generate-with-bootstrap"
POSTGRES_DB="smartrag"
# DATABASE_URL is derived from the variables above — do not edit manually
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@smartrag-postgres:5432/${POSTGRES_DB}"


# ── Weaviate ─────────────────────────────────────────────────────────────────
WEAVIATE_API_KEY="generate-with-bootstrap"


# ── Neo4j ────────────────────────────────────────────────────────────────────
# NEO4J_AUTH must be "neo4j/<password>" — bootstrap.sh keeps both in sync
NEO4J_PASSWORD="generate-with-bootstrap"
NEO4J_AUTH="neo4j/${NEO4J_PASSWORD}"


# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD="generate-with-bootstrap"
# Langfuse reads its Redis credential from REDIS_AUTH, not REDIS_PASSWORD
# (see Langfuse's self-hosting docs on the cache). It takes its whole
# configuration from this file via env_file, so a name it does not recognise
# means it connects with no password at all — and Redis answers WRONGPASS,
# which reads like a wrong credential rather than a missing variable.
# Flowise sets REDIS_AUTH for itself in docker-compose.yml; Langfuse cannot.
REDIS_AUTH="${REDIS_PASSWORD}"
REDIS_HOST="smartrag-redis"
REDIS_PORT=6379
REDIS_TLS_ENABLED=false


# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER="smartrag-admin"
MINIO_ROOT_PASSWORD="generate-with-bootstrap"
MINIO_REGION_NAME="eu-central-1"

# Langfuse service account — created automatically by bootstrap.sh inside MinIO.
# MINIO_LANGFUSE_ACCESS_KEY is a username (not secret), MINIO_LANGFUSE_SECRET_KEY is the password.
MINIO_LANGFUSE_ACCESS_KEY="langfuse-user"
MINIO_LANGFUSE_SECRET_KEY="generate-with-bootstrap"


# ── ClickHouse ───────────────────────────────────────────────────────────────
CLICKHOUSE_USER="ch_admin"
CLICKHOUSE_PASSWORD="generate-with-bootstrap"
CLICKHOUSE_URL="http://smartrag-clickhouse:8123"
CLICKHOUSE_MIGRATION_URL="clickhouse://smartrag-clickhouse:9000"
CLICKHOUSE_CLUSTER_ENABLED=false


# ── Flowise ──────────────────────────────────────────────────────────────────
FLOWISE_USERNAME="admin"
FLOWISE_PASSWORD="generate-with-bootstrap"
# SALT: used by Flowise for password hashing and by Langfuse for API key hashing.
# Shared across both services in this single-env setup — intentional.
SALT="generate-with-bootstrap"
ENCRYPTION_KEY="generate-with-bootstrap"
JWT_AUTH_TOKEN_SECRET="generate-with-bootstrap"
JWT_REFRESH_TOKEN_SECRET="generate-with-bootstrap"
EXPRESS_SESSION_SECRET="generate-with-bootstrap"
TOKEN_HASH_SECRET="generate-with-bootstrap"
FLOWISE_EE_LICENSE_KEY=


# ── n8n ──────────────────────────────────────────────────────────────────────
N8N_ENCRYPTION_KEY="generate-with-bootstrap"
N8N_USER_MANAGEMENT_JWT_SECRET="generate-with-bootstrap"
N8N_DB_TYPE="postgresdb"
N8N_DB_POSTGRESDB_HOST="smartrag-postgres"
N8N_DB_POSTGRESDB_USER="${POSTGRES_USER}"
N8N_DB_POSTGRESDB_PASSWORD="${POSTGRES_PASSWORD}"
N8N_DB_POSTGRESDB_DATABASE="n8n"


# ── Langfuse ─────────────────────────────────────────────────────────────────
# Pin to a specific version — check https://github.com/langfuse/langfuse/releases
LANGFUSE_IMAGE_TAG="3.224.2"
NEXTAUTH_URL="https://langfuse.${DOMAIN}"
NEXTAUTH_SECRET="generate-with-bootstrap"

# Langfuse email notifications — derived from the MAIL RELAY (SMTP) section
# above. SMTP_CONNECTION_URL is computed by the wizard (URL-encoded) from
# SMTP_HOST/PORT/USER/PASSWORD; leave both empty to disable notifications.
LANGFUSE_EMAIL_FROM_ADDRESS="${SMTP_SENDER_EMAIL}"
SMTP_CONNECTION_URL=""

# ── Langfuse — MinIO/S3 storage ──────────────────────────────────────────────
# Langfuse requires three separate S3 configurations (events, media, exports).
# All three point to the internal MinIO service — do not change endpoints unless
# you are replacing MinIO with an external S3-compatible storage.
LANGFUSE_USE_AZURE_BLOB=false

LANGFUSE_S3_EVENT_UPLOAD_BUCKET="langfuse-events"
LANGFUSE_S3_EVENT_UPLOAD_REGION="${MINIO_REGION_NAME}"
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT="http://smartrag-minio:9000"
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID="${MINIO_LANGFUSE_ACCESS_KEY}"
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY="${MINIO_LANGFUSE_SECRET_KEY}"
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX="events/"

LANGFUSE_S3_MEDIA_UPLOAD_BUCKET="langfuse-media"
LANGFUSE_S3_MEDIA_UPLOAD_REGION="${MINIO_REGION_NAME}"
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT="http://smartrag-minio:9000"
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID="${MINIO_LANGFUSE_ACCESS_KEY}"
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY="${MINIO_LANGFUSE_SECRET_KEY}"
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX="media/"

LANGFUSE_S3_BATCH_EXPORT_ENABLED=true
LANGFUSE_S3_BATCH_EXPORT_BUCKET="langfuse-exports"
LANGFUSE_S3_BATCH_EXPORT_REGION="${MINIO_REGION_NAME}"
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID="${MINIO_LANGFUSE_ACCESS_KEY}"
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY="${MINIO_LANGFUSE_SECRET_KEY}"
LANGFUSE_S3_BATCH_EXPORT_FORCE_PATH_STYLE=true
LANGFUSE_S3_BATCH_EXPORT_ENDPOINT="http://smartrag-minio:9000"
LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT="https://minio.${DOMAIN}"


# ── Content Admin GUI ────────────────────────────────────────────────────────
# Course-content authoring (agent prompts, knowledge graph) — see
# https://content.${DOMAIN} after deployment. Unlike almost everything else
# in this file, these are NOT set by the bootstrap wizard — the GUI writes
# them itself on first use (its own admin account, then the Flowise API key
# once you've generated one in Flowise's UI). Leave empty here.
CONTENT_ADMIN_USERNAME=""
CONTENT_ADMIN_PASSWORD_HASH=""
# Set only while a password reset is in flight, and cleared the moment the
# new password is saved. The token itself is never stored — only its SHA-256
# — so a reader of this file cannot use one they find here.
CONTENT_ADMIN_RESET_TOKEN_HASH=""
CONTENT_ADMIN_RESET_EXPIRES=""
CONTENT_ADMIN_SESSION_SECRET="generate-with-bootstrap"
FLOWISE_API_KEY=""


# ── LTI Middleware ───────────────────────────────────────────────────────────
# Only active if COMPOSE_PROFILES includes "lti".
# After deployment, configure agent-to-chatflow mappings in:
#   lti-middleware/config/agents.json
# Customise UI text/branding in:
#   lti-middleware/config/branding.json

# Public URL of your LMS — used for CORS on /consent/check
# Examples: https://moodle.your-uni.edu | https://ilias.your-org.de
LMS_URL="https://lms.example.com"

LTI_SESSION_SECRET="generate-with-bootstrap"

# Flowise Chatflow UUIDs — set AFTER deploying agents in Flowise.
# Find each UUID in the Flowise UI under the agent's "API" tab.
# Leave empty for agent slots you are not using.
CHATFLOW_AGENT01=""
CHATFLOW_AGENT02=""
CHATFLOW_AGENT03=""
CHATFLOW_AGENT04=""
CHATFLOW_AGENT05=""
CHATFLOW_AGENT06=""
CHATFLOW_AGENT07=""
CHATFLOW_AGENT08=""
CHATFLOW_AGENT09=""
CHATFLOW_AGENT10=""
CHATFLOW_AGENT11=""
CHATFLOW_AGENT12=""
CHATFLOW_AGENT13=""
CHATFLOW_AGENT14=""
