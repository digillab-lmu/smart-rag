# ── Secrets & Credentials ────────────────────────────────────────────────────
.env
**/.env
*.key
*.pem
credentials.txt          # generated by bootstrap.sh — contains initial passwords

# ── Local working files (not for repo) ───────────────────────────────────────
CONTEXT.md
ANALYSIS.md

# ── Docker volumes & data ────────────────────────────────────────────────────
**/data/
**/volumes/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
**/logs/
bootstrap.log

# ── Bootstrap state ──────────────────────────────────────────────────────────
# Staging dir for generated configs (Weaviate schema, nginx, etc.) — recreated on each run
**/staging/
# .env backups created automatically before overwrite
.env.backup-*
# LTI runtime config (copied from *.example by bootstrap; contains LMS-specific values)
lti-middleware/config/lti.json
lti-middleware/config/agents.json
lti-middleware/config/branding.json

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
