# ── Secrets & Credentials ────────────────────────────────────────────────────
.env
**/.env
*.key
*.pem
# generated by bootstrap.sh — contains the initial passwords. The comment
# is on its own line deliberately: in .gitignore a '#' only starts a
# comment at the beginning of a line, so a trailing one becomes part of
# the pattern and the rule silently matches nothing.
credentials.txt
# TLS certificates fetched onto the host (Tailscale writes
# <machine>.<tailnet>.ts.net.crt next to its key).
*.crt
*.csr

# ── Local working files (not for repo) ───────────────────────────────────────
CONTEXT.md
ANALYSIS.md

# ── Docker volumes & data ────────────────────────────────────────────────────
**/data/
**/volumes/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
**/logs/
bootstrap.log

# ── Bootstrap state ──────────────────────────────────────────────────────────
# Staging dir for generated configs (Weaviate schema, nginx, etc.) — recreated on each run
**/staging/
# .env backups created automatically before overwrite
.env.backup-*
# LTI runtime config (copied from *.example by bootstrap; contains LMS-specific values)
lti-middleware/config/lti.json
lti-middleware/config/agents.json
lti-middleware/config/branding.json

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
