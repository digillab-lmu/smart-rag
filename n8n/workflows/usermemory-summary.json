    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const response = $input.item.json;\nconst vars = $('Check and Prepare').item.json;\nconst { user_id, memory_id, existing, max_chapter, last_updated_now } = vars;\n\n// OpenAI-compatible chat/completions shape, which is what every provider\n// this project supports speaks. The node before this was an Anthropic node\n// with a hard-coded model, so on an installation configured for any other\n// provider it could not run at all — and the parser read content[0].text,\n// which only Anthropic returns.\nconst raw = response?.choices?.[0]?.message?.content || '';\n\n// Thinking-Tags entfernen (falls Modell trotzdem denkt)\nconst cleaned = raw.replace(/<think>[\\s\\S]*?<\\/think>/gi, '').trim();\n\n// JSON extrahieren\nconst jsonMatch = cleaned.match(/\\{[\\s\\S]*\\}/);\nif (!jsonMatch) {\n  return {\n    json: {\n      parse_error: true,\n      error_reason: 'no_json_found',\n      user_id,\n      memory_id,\n      raw_preview: raw.substring(0, 300)\n    }\n  };\n}\n\nlet parsed;\ntry {\n  parsed = JSON.parse(jsonMatch[0]);\n} catch(e) {\n  return {\n    json: {\n      parse_error: true,\n      error_reason: 'json_parse_failed',\n      user_id,\n      memory_id,\n      error: e.message,\n      raw_preview: cleaned.substring(0, 300)\n    }\n  };\n}\n\n// REPLACE: concepts_mastered (nur aktuelle Session, max. 5)\nconst newMastered = parsed.concepts_mastered || [];\n\n// REPLACE: concepts_struggling (nur aktuelle Session, max. 5), REMOVE wenn auch in mastered\nconst newStruggling = (parsed.concepts_struggling || [])\n  .filter(c => !newMastered.includes(c));\n\n// open_questions: REPLACE (aktuelle Session)\nconst newOpenQuestions = parsed.open_questions || [];\n\n// learning_patterns: LLM konsolidiert (REPLACE, enthält Historie)\nconst newLearningPatterns = parsed.learning_patterns || existing.learning_patterns || '';\n\n// summary: REPLACE (aktuelle Session)\nconst newSummary = parsed.summary || '';\n\nreturn {\n  json: {\n    parse_error: false,\n    user_id,\n    memory_id,\n    weaviate_object: {\n      class: 'UserMemory',\n      properties: {\n        // One installation can host several courses; without this the record\n        // would be shared across all of them.\n        course_id: $env.COURSE_ID || '',\n        user_id,\n        concepts_mastered: newMastered,\n        concepts_struggling: newStruggling,\n        open_questions: newOpenQuestions,\n        learning_patterns: newLearningPatterns,\n        summary: newSummary,\n        chapter: max_chapter || 0,\n        last_updated: last_updated_now\n      }\n    }\n  }\n};"
      },
