        "jsCode": "const response = $input.item.json;\nconst mergeVars = $('Parse and Merge').item.json;\nconst { user_id, memory_id } = mergeVars;\n\nif (!response?.id) {\n  return {\n    json: {\n      post_ok: false,\n      user_id,\n      error: 'POST to Weaviate returned no ID',\n      response_preview: JSON.stringify(response).substring(0, 200)\n    }\n  };\n}\n\nreturn {\n  json: {\n    post_ok: true,\n    user_id,\n    new_object_id: response.id,\n    old_memory_id: memory_id\n  }\n};"
