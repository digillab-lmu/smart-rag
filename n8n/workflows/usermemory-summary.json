    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const response = $input.item.json;\nconst vars = $('Process Memory').item.json;\nconst { user_id, memory_id, existing } = vars;\nconst chatData = response?.data?.Get?.ChatHistory || [];\n\n// [A] Keine neuen Messages\nif (chatData.length === 0) {\n  return { json: { skip: true, reason: 'no_new_messages', user_id } };\n}\n\n// [B] Session noch aktiv (< 30 Min Inaktivität)\nconst timestamps = chatData.map(m => new Date(m.timestamp).getTime());\nconst maxTimestamp = Math.max(...timestamps);\nconst diffMin = (Date.now() - maxTimestamp) / 60000;\nif (diffMin < 30) {\n  return { json: { skip: true, reason: 'session_active', user_id, inactive_min: Math.round(diffMin) } };\n}\n\nconst maxChapter = Math.max(...chatData.map(m => m.chapter || 0));\n\nconst messagesText = chatData\n  .map(m => m.role === 'user'\n    ? `[user]: ${m.text}`\n    : `[assistant]: ${m.text.slice(0, 200)}`)\n  .join('\\n');\n\nreturn {\n  json: {\n    skip: false,\n    user_id,\n    memory_id,\n    existing,\n    max_chapter: maxChapter,\n    last_updated_now: new Date().toISOString(),\n    messagesText\n  }\n};"
      },
      "id": "5c81e7f5-582b-4710-8d1e-09b03bf47be3",
      "name": "Check and Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2256,
        208
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
