        "jsonBody": "={{ JSON.stringify({\n  model: $env.LLM_MODEL_FAST || 'gpt-4o-mini',\n  temperature: 0.1,\n  response_format: { type: 'json_object' },\n  messages: [\n    { role: 'system', content: \"Du analysierst eine Lern-Session eines Studierenden im Kurs \" + ($env.COURSE_NAME || 'diesem Kurs') + \". Antworte NUR mit einem validen JSON-Objekt. Kein Markdown, keine Erklärungen, keine Backticks, kein Text vor oder nach dem JSON.\" },\n    { role: 'user',   content: \"Bisherige Lernmuster des Studierenden:\\n\\\"\" + ($('Check and Prepare').item.json.existing.learning_patterns || '') + \"\\\"\\n\\nNeue Session-Nachrichten:\\n\" + $('Check and Prepare').item.json.messagesText + \"\\n\\nGib ausschließlich dieses JSON-Objekt zurück (keine anderen Zeichen):\\n{\\n  \\\"concepts_mastered\\\": [...],\\n  \\\"concepts_struggling\\\": [...],\\n  \\\"open_questions\\\": [...],\\n  \\\"learning_patterns\\\": \\\"...\\\",\\n  \\\"summary\\\": \\\"...\\\"\\n}\" }\n  ]\n}) }}",
