{
  "_comment": "Which agent slot an LTI launch reaches, and how it is embedded. The `id` is what the LMS sends as the custom parameter `agent_id` and what appears in the URL; it is stable and should not be renamed after deployment, because session data carries it. The `slot` is the agent slot in the Content Admin, 1 to 10. The chatflow itself is not configured here: it is read from the database at launch time, so an agent re-imported in the Content Admin is reachable immediately, without recreating this container.",

  "agents": [
    { "id": "agent-01", "slot": 1,  "embed_style": "bubble" },
    { "id": "agent-02", "slot": 2,  "embed_style": "fullscreen" },
    { "id": "agent-03", "slot": 3,  "embed_style": "fullscreen" },
    { "id": "agent-04", "slot": 4,  "embed_style": "fullscreen" },
    { "id": "agent-05", "slot": 5,  "embed_style": "fullscreen" },
    { "id": "agent-06", "slot": 6,  "embed_style": "fullscreen" },
    { "id": "agent-07", "slot": 7,  "embed_style": "fullscreen" },
    { "id": "agent-08", "slot": 8,  "embed_style": "fullscreen" },
    { "id": "agent-09", "slot": 9,  "embed_style": "fullscreen" },
    { "id": "agent-10", "slot": 10, "embed_style": "fullscreen" }
  ]
